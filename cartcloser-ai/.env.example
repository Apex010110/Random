# Copy to .env (never commit .env). All values are safe demo defaults.
APP_ENV=demo                     # demo | production  (demo enables /demo/* and trigger-now)
DATABASE_URL=sqlite:///./cartcloser_demo.db   # docker compose overrides this with Postgres
POSTGRES_PASSWORD=cartcloser-dev-only

# Demo merchant auth tokens (replace in any shared deployment)
DEMO_MERCHANT_TOKEN=demo-merchant-token
DEMO_OTHER_TENANT_TOKEN=other-tenant-token
LINK_SIGNING_SECRET=dev-only-change-me   # signs recovery checkout links

# Optional AI provider. Leave the key empty to use the deterministic rule-based assistant.
AI_PROVIDER=rules                # rules | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=8

# Webhook secrets. Empty => endpoints answer 503 "not connected".
SHOPIFY_WEBHOOK_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

CORS_ORIGINS=*
